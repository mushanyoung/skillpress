{
  "name": "@mushanyoung/skillpress",
  "version": "0.1.0",
  "description": "Build, evaluate, package, and publish production-grade Agent Skills.",
  "license": "MIT",
  "author": "Mushan Yang <mushanyoung@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushanyoung/skillpress.git"
  },
  "homepage": "https://github.com/mushanyoung/skillpress#readme",
  "bugs": {
    "url": "https://github.com/mushanyoung/skillpress/issues"
  },
  "keywords": [
    "agent-skills",
    "cli",
    "evals",
    "skills",
    "tessl"
  ],
  "type": "module",
  "bin": {
    "skillpress": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
